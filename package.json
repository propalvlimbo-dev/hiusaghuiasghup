{
  "name": "soulfire-fleet-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Лёгкая веб-панель для управления группами SoulFire",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@soulfiremc/sdk": "2.10.2",
    "effect": "4.0.1",
    "express": "5.2.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.3"
  }
}
